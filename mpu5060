
#include <Wire.h>
#include <WiFi.h>
#include <WiFiUdp.h>

// =================================
// 1. Wi-Fi 설정
// =================================

const char* ssid = "iPhone (2)";
const char* password = "apple0725";

// PC의 IPv4 주소
const char* pcIP = "172.20.10.7";

const int udpPort = 4210;

WiFiUDP udp;

bool wifiReady = false;
bool sensorReady = false;

unsigned long lastWifiCheck = 0;


// =================================
// 2. 센서 설정
// =================================

#define MPU_ADDR 0x68
#define IR_PIN 27


// =================================
// 3. MPU6050 초기화
// =================================

void initMPU() {

  Serial.println("Initializing MPU6050...");

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B);
  Wire.write(0x00);

  if (Wire.endTransmission() != 0) {
    sensorReady = false;
    Serial.println("MPU6050 Init Failed!");
    return;
  }

  delay(100);

  // 가속도 측정 범위 ±2g
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x1C);
  Wire.write(0x00);

  if (Wire.endTransmission() != 0) {
    sensorReady = false;
    Serial.println("MPU6050 Setting Failed!");
    return;
  }

  sensorReady = true;

  Serial.println("MPU6050 Ready!");
}


// =================================
// 4. Wi-Fi 연결
// =================================

bool connectWiFi() {

  Serial.println();
  Serial.println("Connecting to WiFi...");

  // 기존 연결 정리
  WiFi.disconnect(true, true);
  delay(500);

  WiFi.mode(WIFI_STA);
  delay(500);

  WiFi.begin(ssid, password);

  int count = 0;

  while (WiFi.status() != WL_CONNECTED && count < 30) {

    delay(500);
    Serial.print(".");

    count++;
  }

  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println("WiFi Connected!");

    Serial.print("ESP32 IP: ");
    Serial.println(WiFi.localIP());

    Serial.print("PC IP: ");
    Serial.println(pcIP);

    udp.begin(4211);

    wifiReady = true;

    return true;
  }

  Serial.println("WiFi Connection Failed!");

  Serial.print("WiFi Status: ");
  Serial.println(WiFi.status());

  WiFi.disconnect();

  wifiReady = false;

  return false;
}


// =================================
// 5. Setup
// =================================

void setup() {

  Serial.begin(115200);

  pinMode(IR_PIN, INPUT);

  // I2C 설정
  Wire.begin(21, 22);
  Wire.setClock(100000);
  Wire.setTimeOut(100);

  // 센서 초기화
  initMPU();

  // Wi-Fi 연결
  wifiReady = connectWiFi();
}


// =================================
// 6. Loop
// =================================

void loop() {

  // -----------------------------
  // Wi-Fi 연결 확인
  // -----------------------------

  if (WiFi.status() != WL_CONNECTED) {

    wifiReady = false;

    if (millis() - lastWifiCheck >= 5000) {

      lastWifiCheck = millis();

      Serial.println("WiFi disconnected. Reconnecting...");

      connectWiFi();
    }

    delay(100);
    return;
  }

  wifiReady = true;


  // -----------------------------
  // MPU6050 연결 확인
  // -----------------------------

  Wire.beginTransmission(MPU_ADDR);

  byte error = Wire.endTransmission();

  if (error != 0) {

    sensorReady = false;

    Serial.println("Sensor Disconnected!");

    delay(500);
    return;
  }


  // -----------------------------
  // 센서 재초기화
  // -----------------------------

  if (!sensorReady) {

    initMPU();

    delay(500);
    return;
  }


  // -----------------------------
  // 가속도 데이터 읽기
  // -----------------------------

  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);

  if (Wire.endTransmission(false) != 0) {

    sensorReady = false;

    Serial.println("Sensor Read Error!");

    return;
  }

  if (Wire.requestFrom(MPU_ADDR, 6, true) != 6) {

    sensorReady = false;

    Serial.println("Data Read Failed!");

    return;
  }

  int16_t x = (Wire.read() << 8) | Wire.read();
  int16_t y = (Wire.read() << 8) | Wire.read();
  int16_t z = (Wire.read() << 8) | Wire.read();


  // -----------------------------
  // IR 센서 데이터 읽기
  // -----------------------------

  int irValue = digitalRead(IR_PIN);


  // -----------------------------
  // UDP 데이터 구성
  // -----------------------------

  String data = String(x) + "," +
                String(y) + "," +
                String(z) + "," +
                String(irValue);


  // -----------------------------
  // PC로 데이터 전송
  // -----------------------------

  udp.beginPacket(pcIP, udpPort);

  udp.print(data);

  udp.endPacket();


  // -----------------------------
  // 시리얼 모니터 출력
  // -----------------------------

  Serial.println("-----------------------");

  Serial.print("X: ");
  Serial.print(x);

  Serial.print(" | Y: ");
  Serial.print(y);

  Serial.print(" | Z: ");
  Serial.println(z);

  Serial.print("IR: ");
  Serial.println(irValue);

  Serial.print("Sent: ");
  Serial.println(data);

  delay(100);
}
